# Database
DB_HOST_LOCAL="localhost"
DB_HOST_PORT=5432
DB_USER="postgres"
DB_PASSWORD="password"

# Comma-separated list of internal patient IDs to exclude from analyses
EXCLUDED_PIDS=""

# Comma-separated list of Databricks patient GUIDs that use the sparcnet_annotations table
SPARCNET_GUIDS=""

# Databricks (only required for paths that hit Databricks tables)
DATABRICKS_ENVIRONMENT=prod
ENABLE_DATABRICKS_IMAGES=true
DATABRICKS_TLS_NO_VERIFY=false
DATABRICKS_SERVER_HOSTNAME="<YOUR_DATABRICKS_SERVER_HOSTNAME>"
DATABRICKS_ACCESS_TOKEN="<YOUR_DATABRICKS_ACCESS_TOKEN>"
DATABRICKS_HTTP_PATH="<YOUR_DATABRICKS_HTTP_PATH>"

# Cohort roster consumed by supplemental_results.ipynb.
# JSON object keyed by DB username; each value carries the manuscript-facing ID
# and per-patient feature flags (which Pioneer features were enabled for that patient).
# Example:
# PARTICIPANTS='{"001": {"manuscript_id": "001", "surveys": true, "seizure": true, "sleep": true, "data_agent": false, "spike": false}}'
PARTICIPANTS=""
